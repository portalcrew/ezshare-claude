{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/web/main.tsx",
        "src/runner/main.ts",
        "scripts/*.ts",
        "tests/**/*.test.{ts,tsx}",
        "tests/support/setup.ts",
        "tests/support/bin/*.mjs"
    ],
    "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,tsx,mjs}"],
    "ignoreBinaries": ["script"],
    "ignoreDependencies": ["tailwindcss"],
    "includeEntryExports": true
}
